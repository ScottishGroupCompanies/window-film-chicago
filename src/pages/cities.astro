---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSubpage from '../components/HeroSubpage.astro';
import BrandLogos from '../components/BrandLogos.astro';
import CTAAvatars from '../components/CTAAvatars.astro';
import CoveragePinMap from '../components/CoveragePinMap.astro';

const title = 'Window Film Service Areas | Chicago & Suburbs | Illinois';
const description = 'Window Film Chicago serves Chicago and 19 surrounding suburbs across Cook, DuPage, Kane, Lake, and Will Counties. Free on-site estimates.';

const suburbs = [
  { name: 'Arlington Heights', desc: 'Northwest suburb with a mix of mid-century ranches and newer construction — solar and low-E film for year-round energy savings.' },
  { name: 'Aurora', desc: "Illinois' second-largest city, with historic homes and large commercial corridors along the Fox River." },
  { name: 'Berwyn', desc: 'Bungalow-belt community just west of the city — classic Chicago-style brick homes that benefit from winter heat-retention film.' },
  { name: 'Bolingbrook', desc: 'Fast-growing southwest suburb with newer residential developments and retail parks along I-55.' },
  { name: 'Cicero', desc: 'Dense inner-ring suburb with two-flats and brick multi-family — solar and security film for tight residential blocks.' },
  { name: 'Des Plaines', desc: "Northwest suburb near O'Hare — mixed residential and commercial, with wind-exposed glazing near the airport corridor." },
  { name: 'Elgin', desc: 'Fox River city with historic downtown buildings and expanding suburban subdivisions to the west.' },
  { name: 'Evanston', desc: 'Lakefront suburb and home of Northwestern University — lake glare, campus buildings, and high-end residential along the shore.' },
  { name: 'Mount Prospect', desc: 'Northwest suburb with a strong mix of residential and retail — solar film for comfort and storefront UV protection.' },
  { name: 'Naperville', desc: 'Large western suburb with a thriving downtown and extensive corporate office parks along the I-88 corridor.' },
  { name: 'Oak Lawn', desc: 'Southwest suburb with postwar bungalows and multi-family — energy film and security film for residential and small commercial.' },
  { name: 'Oak Park', desc: 'Historic inner-ring suburb known for Frank Lloyd Wright architecture — preservation-sensitive film specs for period windows.' },
  { name: 'Orland Park', desc: 'Southwest suburb with large residential lots and a significant retail footprint — solar and security film for homes and storefronts.' },
  { name: 'Palatine', desc: 'Northwest suburb with a mix of older and newer housing stock — low-E and solar film for energy-cost reduction.' },
  { name: 'Schaumburg', desc: 'Major northwest suburb with large-scale commercial and retail (Woodfield area) — high-demand zone for commercial and security film.' },
  { name: 'Skokie', desc: 'Inner north suburb with diverse housing stock and commercial strips along Dempster and Oakton — solar, security, and decorative film.' },
  { name: 'Tinley Park', desc: 'South suburb with strong residential growth and a walkable downtown — energy and security film for homes and small business.' },
  { name: 'Waukegan', desc: 'Lakefront city to the north — lake-glare issues for shore-facing properties, plus industrial and commercial film needs.' },
  { name: 'Wheaton', desc: 'DuPage County seat with historic homes and institutional buildings — preservation-appropriate and energy film specs.' },
];
---

<BaseLayout title={title} description={description} canonical="https://windowfilmchicago.com/cities/">

<HeroSubpage
  eyebrow="Service Areas"
  title="Chicagoland Cities We Serve"
  subtitle="Professional window film across Chicago and 19 surrounding suburbs — Cook, DuPage, Kane, Lake, and Will Counties."
  bg="/images/wfp-cities-hero.jpg"
  cta1={{ label: 'Get a Free Quote', href: '/contact/' }}
  cta2={{ label: 'See Our Services', href: '/services/' }}
/>

<div class="ip-page-body">

<!-- ══════════════════════════════════════
     INTRO — 2-col: big heading left, text + CTAs right
     ══════════════════════════════════════ -->
<section class="cp-intro">
  <div class="cp-intro__inner">
    <div class="cp-intro__left">
      <span class="cp-eyebrow">Service Area</span>
      <h2 class="cp-intro__title">Window film installation across Chicago and Chicagoland.</h2>
    </div>
    <div class="cp-intro__right">
      <p class="cp-intro__lead">Window Film Chicago serves the city of Chicago and 19 surrounding suburbs across Cook, DuPage, Kane, Lake, and Will Counties. Each location is served by the same 8-person installation team and the same manufacturer-grade product line — no satellite offices, no subcontractors. See our full <a href="/cities/chicago/" class="cp-inline-link">Chicago service page</a> for details on city neighborhoods, or browse the suburbs below.</p>
      <div class="cp-intro__ctas">
        <a href="/contact/" class="cp-btn cp-btn--primary">Get a Free Quote</a>
        <a href="/applications/" class="cp-btn cp-btn--ghost">Our Applications</a>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════
     CHICAGO — featured card linking to the full city page
     ══════════════════════════════════════ -->
<section class="cp-cities">
  <a href="/cities/chicago/" class="cp-city-card cp-city-card--featured fade-in">
    <div class="cp-city-card__img">
      <img src="/images/wfp-cities-chicago.jpg" alt="Window film Chicago Illinois" title="Window film Chicago Illinois" loading="lazy" />
      <span class="cp-city-card__badge">IL</span>
    </div>
    <div class="cp-city-card__body">
      <h3 class="cp-city-card__title">Chicago</h3>
      <div class="cp-city-card__rule"></div>
      <p class="cp-city-card__desc">Our home base and primary service area — from the Loop to the bungalow belt. Full details on neighborhoods, property types, and services on our dedicated Chicago page.</p>
      <span class="cp-city-card__cta">
        Explore Chicago
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/></svg>
      </span>
    </div>
  </a>
</section>

<!-- ══════════════════════════════════════
     SUBURBS — directory grid (no dedicated pages, informational only)
     ══════════════════════════════════════ -->
<section class="cp-suburbs">
  <div class="cp-suburbs__header">
    <h2 class="cp-suburbs__title">Chicagoland Suburbs We Serve</h2>
    <p class="cp-suburbs__subtitle">Don\'t see your suburb listed as a separate page — we still serve it directly. Call <a href="tel:+17734532005" class="cp-inline-link">(773) 453-2005</a> or use the contact form to request a free estimate anywhere in our service area.</p>
  </div>
  <div class="cp-suburbs__grid">
    {suburbs.map((s) => (
      <div class="cp-suburb-card">
        <h3 class="cp-suburb-card__title">{s.name}</h3>
        <p class="cp-suburb-card__desc">{s.desc}</p>
      </div>
    ))}
  </div>
</section>

<!-- ══════════════════════════════════════
     COVERAGE MAP — interactive pin map
     ══════════════════════════════════════ -->
<CoveragePinMap
  title="Don\'t see your city?"
  subtitle="We travel throughout the Chicago metropolitan area and regularly serve communities across Cook, DuPage, Kane, Lake, and Will Counties. Contact us to discuss your project."
/>

<!-- ══════════════════════════════════════
     BRAND LOGOS
     ══════════════════════════════════════ -->
<BrandLogos />

</div><!-- end ip-page-body -->

<!-- ══════════════════════════════════════
     CTA — AVATARS (full-width, outside ip-page-body)
     ══════════════════════════════════════ -->
<CTAAvatars
  title="Ready to get started in your city?"
  subtitle="Free consultation, transparent pricing, and manufacturer-backed warranties on every install."
  count="Trusted by homeowners & businesses across Chicagoland"
  btnLabel="Get a Free Quote"
  btnHref="/contact/"
/>

</BaseLayout>

<style>
/* ── PAGE BODY WRAPPER ── */
.ip-page-body {
  position: relative;
  background: #ffffff;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* ── EYEBROW ── */
.cp-eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

.cp-inline-link {
  color: var(--green, #81AB4C);
  font-weight: 600;
  text-decoration: underline;
}

/* ── BUTTONS ── */
.cp-btn {
  display: inline-block; padding: 14px 28px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; font-weight: 500;
  text-decoration: none; transition: all 0.2s;
  border: 2px solid transparent; white-space: nowrap;
}
.cp-btn--primary { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.cp-btn--primary:hover { background: #6e9640; border-color: #6e9640; transform: translateY(-2px); color: #fff; }
.cp-btn--ghost { background: transparent; color: var(--brand, #272E32); border-color: var(--brand, #272E32); }
.cp-btn--ghost:hover { background: var(--brand, #272E32); color: #fff; transform: translateY(-2px); }

/* ── INTRO ── */
.cp-intro {
  padding: 80px 10%;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  overflow: hidden;
}
.cp-intro__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.cp-intro__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  letter-spacing: -0.5px;
  line-height: 1.15;
  color: var(--text-dark, #1a1a1a);
}
.cp-intro__lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  line-height: 1.6;
  color: var(--text-mid, #4a4a4a);
  margin-bottom: 24px;
}
.cp-intro__ctas {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}

/* ── FEATURED CHICAGO CARD ── */
.cp-cities {
  padding: 0 10% 40px;
}
.cp-city-card {
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 40px;
  align-items: center;
  background: var(--off-white, #F7F6F3);
  border-radius: var(--radius-lg, 24px);
  padding: 32px;
  text-decoration: none;
  transition: transform 0.25s;
}
.cp-city-card:hover { transform: translateY(-4px); }
.cp-city-card__img {
  position: relative;
  border-radius: var(--radius-md, 16px);
  overflow: hidden;
  aspect-ratio: 4/3;
}
.cp-city-card__img img { width: 100%; height: 100%; object-fit: cover; }
.cp-city-card__badge {
  position: absolute; top: 16px; right: 16px;
  background: rgba(0,0,0,0.6); color: #fff;
  font-size: 12px; font-weight: 700;
  padding: 4px 10px; border-radius: 6px;
}
.cp-city-card__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(24px, 3vw, 32px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin-bottom: 12px;
}
.cp-city-card__rule {
  width: 40px; height: 3px;
  background: var(--green, #81AB4C);
  margin-bottom: 16px;
}
.cp-city-card__desc {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; line-height: 1.6;
  color: var(--text-mid, #4a4a4a);
  margin-bottom: 16px;
}
.cp-city-card__cta {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-weight: 600; color: var(--green, #81AB4C);
}

/* ── SUBURBS GRID ── */
.cp-suburbs {
  padding: 40px 10% 60px;
}
.cp-suburbs__header {
  margin-bottom: 32px;
}
.cp-suburbs__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin-bottom: 12px;
}
.cp-suburbs__subtitle {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; line-height: 1.6;
  color: var(--text-mid, #4a4a4a);
}
.cp-suburbs__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.cp-suburb-card {
  background: var(--off-white, #F7F6F3);
  border-radius: var(--radius-md, 16px);
  padding: 24px;
}
.cp-suburb-card__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 19px; font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin-bottom: 8px;
}
.cp-suburb-card__desc {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px; line-height: 1.55;
  color: var(--text-mid, #4a4a4a);
}

@media (max-width: 900px) {
  .cp-intro__inner { grid-template-columns: 1fr; gap: 32px; }
  .cp-city-card { grid-template-columns: 1fr; }
  .cp-suburbs__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .cp-suburbs__grid { grid-template-columns: 1fr; }
}
</style>
